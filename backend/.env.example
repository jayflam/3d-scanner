# Azure OpenAI – required for real damage assessment
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-key>
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# TripoSR
TRIPOSR_MODEL_ID=stabilityai/TripoSR
TRIPOSR_DEVICE=cuda:0
TRIPOSR_CHUNK_SIZE=8192
TRIPOSR_MC_RESOLUTION=256
TRIPOSR_TEXTURE_RESOLUTION=2048
TRIPOSR_FOREGROUND_RATIO=0.85

# Server
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
